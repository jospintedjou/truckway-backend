# ---- Keys (required) ----
# Free key: https://developer.tomtom.com  (Routing + Search APIs)
TOMTOM_API_KEY=

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
# Add your public domain(s), e.g. truckway.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to call the API directly (not needed when the frontend proxies /api)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8020

# ---- Optional ----
# Host port for the production container
API_PORT=8021
# Leave empty to use the free Open-Meteo API
OPEN_METEO_API_KEY=
# Empty tractor + trailer weight added to the load for truck routing (lb)
TRUCK_TARE_LB=34000
# Allow the labeled demo storm (?scenario=storm)
ENABLE_SCENARIOS=true
THROTTLE_PLAN=20/min
THROTTLE_IP=120/min
